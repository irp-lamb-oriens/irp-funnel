{
  "extends": "./.svelte-kit/tsconfig.json", // Extend the SvelteKit generated config
  "compilerOptions": {
    "lib": ["es2020", "dom"],
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    // Add explicit path mapping as a fallback.
    // NOTE: a child tsconfig's `paths` REPLACES (does not merge) the inherited
    // SvelteKit paths, so `$lib`/`$lib/*` must be re-declared here or imports
    // like `$lib/money.ts` fail type resolution (Vite still resolves them via
    // svelte.config alias, which is why the build succeeds regardless).
    "paths": {
      "$lib": ["./src/lib"],
      "$lib/*": ["./src/lib/*"],
      "$app/*": ["./node_modules/@sveltejs/kit/src/runtime/app/*"]
    }

  },
  "include": ["src/**/*", ".svelte-kit/ambient.d.ts"], // Ensure ambient types are included
  "exclude": ["node_modules"]
}
